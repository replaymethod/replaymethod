# Public web application
PUBLIC_SITE_URL=https://replaymethod.xyz
ADMIN_EMAIL=owner@example.com
# Optional comma-separated reviewer allowlists. Stable Sites user IDs are
# preferred; email entries still require a signed-in ChatGPT identity.
ADMIN_EMAILS=
ADMIN_USER_ID=
ADMIN_USER_IDS=

# Independent production kill switches. Each subsystem stays off unless its
# value is exactly "true". Activate one subsystem at a time after its own gate.
BILLING_CHECKOUT_ENABLED=false
TRANSACTIONAL_EMAIL_ENABLED=false
RL_ENGINE_ENABLED=false
RL_PUBLIC_DETECTORS_ENABLED=false
RL_CALIBRATION_INTAKE_ENABLED=false
RL_VIDEO_ANALYSIS_ENABLED=false
RIOT_INGESTION_ENABLED=false
BACKGROUND_PROCESSING_ENABLED=false

# Optional evidence-grounded coaching language layer.
# The deterministic report generator remains available without this key.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=

# Dedicated Rocket League replay service
RL_ENGINE_URL=
RL_ENGINE_TOKEN=
# Web-to-engine deadline, clamped to 5–120 seconds (default 90000).
RL_ENGINE_TIMEOUT_MS=90000
# Native engine process concurrency, clamped to 1–8 (default 1).
RL_ENGINE_MAX_CONCURRENCY=1
# Native per-replay deadline, clamped to 5–115 seconds (default 80000).
RL_ENGINE_JOB_TIMEOUT_MS=80000

# Riot integrations require approved production applications.
# Keep separate game credentials even when they share a player identity flow.
RIOT_LEAGUE_API_KEY=
RIOT_VALORANT_API_KEY=
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_REDIRECT_URI=
# Official API request deadline, clamped to 3–30 seconds (default 10000).
RIOT_API_TIMEOUT_MS=10000

# Optional transactional email
RESEND_API_KEY=
ANALYSIS_FROM_EMAIL=Replay Method <reports@replaymethod.xyz>

# Stripe Billing. Keep STRIPE_MODE=test until the owner separately authorizes
# live-mode activation. Prefer a restricted test key with only the permissions
# listed in docs/STRIPE_TEST_MODE.md; never expose these values to the browser.
STRIPE_MODE=test
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEMIANNUAL=
# Keep both false until the relevant jurisdiction is registered in Stripe Tax.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TAX_REGISTRATION_CONFIRMED=false
STRIPE_MANAGED_PAYMENTS_ENABLED=false
